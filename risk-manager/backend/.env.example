# Risk Manager Backend — environment configuration.
# Copy to .env as needed. Defaults live in backend/src/config/index.ts; every
# variable below shows its default. The frontend key is documented in
# frontend/.env.example (VITE_DEMO_API_KEY, same value as DEMO_API_KEY).

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Persistence ---
# file = JSON repositories under DATA_DIR (default); mongo = MongoDB (audit + idempotency only)
DB_DRIVER=file
MONGODB_URI=mongodb://localhost:27017/risk-manager
DATA_DIR=./data

# --- LLM provider (Risk Manager Agent) ---
# mock = deterministic provider that always escalates (default, no key needed)
# openrouter = real LLM via https://openrouter.ai behind the Agent Output Guard;
#              falls back to mock on any failure. Free-tier model by default —
#              any slug from https://openrouter.ai/models works.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_MS=15000

# --- Detector ---
DETECTOR_TIMEOUT_MS=5000

# --- Payment provider ---
# mock = default (checkout verification always true); razorpay = real HMAC verification
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_TY2gBWjpGTSCAU
RAZORPAY_KEY_SECRET=vqUUc6APdQPP0jZlbT9eWFV5
RAZORPAY_WEBHOOK_SECRET=

# --- Demo auth ---
DEMO_API_KEY=demo-key
REQUIRE_API_KEY=true

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging (pino) ---
# LOG_LEVEL=info

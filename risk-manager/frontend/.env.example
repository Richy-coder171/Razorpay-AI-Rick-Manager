# Frontend environment configuration.
# Copy to .env and adjust as needed. Defaults match the backend's defaults
# (see backend/.env.example and backend/src/config/index.ts).

# Demo API key sent as the x-api-key header on every API call.
# Must match the backend DEMO_API_KEY (default: demo-key).
VITE_DEMO_API_KEY=demo-key

# Base URL of the backend API for hosted deployments (leave unset for local
# dev — Vite's dev proxy handles /api). Example:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# Note: Vite embeds VITE_* variables in the client bundle by design — these
# are demo/public values, never secrets.
# VITE_API_BASE_URL=
